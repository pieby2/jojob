# Environment secrets — NEVER COMMIT
.env
.env.*
!.env.example
*.key
*.pem

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
opt/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

